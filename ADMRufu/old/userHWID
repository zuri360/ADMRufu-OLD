#======CREAR CLIENTE HWID TEMPORAL======
userTMP(){
	local cliente hwid tmp pass osl_v tmp_dir script
	clear
	msg -bar
	print_center -ama "$(fun_trans "CREAR CLIENTE HWID TEMPORAL")"
	print_center -ama "Escriba 0 para volver"
	msg -bar

	while true; do
		msg -ne "$(fun_trans "Nombre De cliente"): "
		read cliente || return
		cliente="$(echo $cliente|sed 'y/áÁàÀãÃâÂéÉêÊíÍóÓõÕôÔúÚñÑçÇªº/aAaAaAaAeEeEiIoOoOoOuUnNcCao/' 2>/dev/null || echo $cliente)"
		cliente="$(echo $cliente|sed -e 's/[^a-z0-9 -]//ig')"
		if [[ -z $cliente ]]; then
			err_fun 1 && continue
		elif [[ "${cliente}" = "0" ]]; then
			return
		elif [[ "${#cliente}" -lt "4" ]]; then
			err_fun 2 && continue
		elif [[ "${#cliente}" -gt "20" ]]; then
			err_fun 3 && continue
		elif grep -q ":hwid,${cliente}:" /etc/passwd; then
			err_fun 14 && continue
		fi
		break
	done

	while true; do
		msg -ne "$(fun_trans "HWID")"
		read -p ": " hwid || return
		hwid="$(echo $hwid|sed 'y/áÁàÀãÃâÂéÉêÊíÍóÓõÕôÔúÚñÑçÇªº/aAaAaAaAeEeEiIoOoOoOuUnNcCao/' 2>/dev/null || echo $hwid)"
		if [[ -z $hwid ]]; then
			err_fun 4 && continue
		elif [[ "${hwid}" = "0" ]]; then
			return
		elif [[ "${#hwid}" -lt "10" ]]; then
			err_fun 5 && continue
		elif [[ "${#hwid}" -gt "40" ]]; then
			err_fun 6 && continue
		elif id "$hwid" &>/dev/null; then
			err_fun 14 && continue
		fi
		break
	done

	while true; do
		msg -ne "$(fun_trans "Duracion en minutos")"
		read -p ": " tmp || return
		if [[ -z "$tmp" ]]; then
			err_fun 7 && continue
		elif [[ "$tmp" = "0" ]]; then
			return
		elif [[ "$tmp" != +([0-9]) ]]; then
			err_fun 8 && continue
		fi
		break
	done

	# misma logica que add_user: usuario y contraseña = HWID, comentario = hwid,cliente
	osl_v=$(openssl version|awk '{print $2}')
	osl_v=${osl_v:0:5}
	if [[ $osl_v = '1.1.1' ]]; then
		pass=$(openssl passwd -6 "$hwid")
	else
		pass=$(openssl passwd -1 "$hwid")
	fi

	if ! useradd -M -s /bin/false -p "${pass}" -c "hwid,${cliente}" "$hwid"; then
		print_center -verm2 "$(fun_trans "Error, Usuario no creado")"
		msg -bar
		sleep 3
		return
	fi

	# guarda los minutos para mostrarlos en la lista
	tmp_dir="${ADM_user:-/etc/ADMRufu/user}/userTMP/users"
	mkdir -p "$tmp_dir"
	echo "$tmp" > "$tmp_dir/$hwid"

	# script que borra el cliente al terminar el tiempo
	script="/tmp/admtmp-$hwid.sh"
	cat > "$script" <<EOS
#!/bin/bash
sleep $(( tmp * 60 ))
pkill -u "$hwid" &>/dev/null
userdel --force "$hwid" &>/dev/null
rm -f "$tmp_dir/$hwid"
rm -f "$script"
EOS
	chmod +x "$script"
	nohup bash "$script" &>/dev/null &

	clear
	msg -bar
	print_center -verd "$(fun_trans "Cliente Temporal Creado con Exito")"
	msg -bar
	msg -ne " $(fun_trans "IP del Servidor"): " && msg -ama "    $(fun_ip)"
	msg -ne " $(fun_trans "Cliente"): " && msg -ama "            $cliente"
	msg -ne " $(fun_trans "Duracion"): " && msg -ama "           $tmp minutos"
	msg -ne " $(fun_trans "HWID"): " && msg -ama "$hwid"
	msg -bar
	print_center -ama "►► Presione enter para continuar ◄◄"
	read
}
